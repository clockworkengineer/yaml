{
    "rust-test-explorer.cargoManifestPath": "${workspaceFolder}/Cargo.toml",
    "rust-test-explorer.loadAll": true,
    "python.testing.unittestArgs": [
        "-v",
        "-s",
        "./library",
        "-p",
        "*test.py"
    ],
    "python.testing.pytestEnabled": false,
    "python.testing.unittestEnabled": true
}