---
version: 3.9
services: 
  production-db: 
    image: mysql:5.7
    volumes: 
      - db_data: /var/lib/mysql
    restart: always
    environment: 
      MYSQL_ROOT_PASSWORD: somewordpress
      MYSQL_DATABASE: wordpress
      MYSQL_USER: wordpress
      MYSQL_PASSWORD: production-password
  test-db: 
    image: mysql:5.7
    volumes: 
      - db_data: /var/lib/mysql
    restart: always
    environment: 
      MYSQL_ROOT_PASSWORD: somewordpress
      MYSQL_DATABASE: wordpress
      MYSQL_USER: wordpress
      MYSQL_PASSWORD: production-password
  environment: 
    MYSQL_ROOT_PASSWORD: somewordpress
    MYSQL_DATABASE: wordpress
    MYSQL_USER: wordpress
    MYSQL_PASSWORD: test-password
...
